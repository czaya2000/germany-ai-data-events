---
import '../styles/theme.css';
import {
	SITE_NAME,
	SITE_URL,
	GOOGLE_SITE_VERIFICATION,
	INDEXABLE,
	withBase,
} from '../lib/events';
import { TRACKER_PRELUDE } from '../lib/tracker-prelude.mjs';
import { LOCALE, UMAMI_WEBSITE_ID, CLOUDFLARE_BEACON_TOKEN, SITE_HOST } from '../../config/country.mjs';

interface Props {
	title: string;
	description: string;
	/** Site-relative path of this page, without the base ("/events/x/"). */
	path: string;
	structuredData?: Record<string, unknown>[];
	/** Keep the page reachable but out of search results (e.g. ended events). */
	noindex?: boolean;
	/** Site-relative path of this page's markdown copy for AI agents (city and type pages). */
	markdown?: string;
}

const { title, description, path, structuredData = [], noindex = false, markdown } = Astro.props;
const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/og-image.png`;

// Self-hosted Archivo (public/fonts): no request to a third-party font CDN.
const fontFiles = [400, 500, 600, 700];
const fontCss = fontFiles
	.map(
		(w) =>
			`@font-face{font-family:'Archivo';font-style:normal;font-weight:${w};font-display:swap;src:url('${withBase(`/fonts/archivo-latin-${w}.woff2`)}') format('woff2');}`,
	)
	.join('');

const analytics = Boolean(UMAMI_WEBSITE_ID || CLOUDFLARE_BEACON_TOKEN);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" as="font" type="font/woff2" href={withBase('/fonts/archivo-latin-400.woff2')} crossorigin />
		<style is:inline set:html={fontCss}></style>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			!INDEXABLE ? (
				<meta name="robots" content="noindex, nofollow" />
			) : (
				noindex && <meta name="robots" content="noindex, follow" />
			)
		}

		<!-- Machine-readable versions of the event list, for feed readers and AI agents -->
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — upcoming events`} href={withBase('/rss.xml')} />
		<link rel="alternate" type="application/json" title={`${SITE_NAME} — events (JSON)`} href={withBase('/events.json')} />
		<link rel="alternate" type="text/plain" title={`${SITE_NAME} — llms.txt`} href={withBase('/llms.txt')} />
		{markdown && <link rel="alternate" type="text/markdown" href={withBase(markdown)} />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={LOCALE} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1469" />
		<meta property="og:image:height" content="772" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#fbfbf9" />
		{GOOGLE_SITE_VERIFICATION && (
			<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
		)}

		{
			structuredData.map((data) => (
				<script type="application/ld+json" set:html={JSON.stringify(data)} />
			))
		}
	</head>
	<body>
		<slot />

		{
			analytics && (
				<>
					{/* Optional, off while the ids in config/country.mjs are empty. The inline
					    script runs before the trackers load: ?notrack stops counting this
					    browser, ?track turns it back on, and any email address is removed
					    from the page address first (Buttondown adds ?email_address=... to
					    /subscribe/thanks/). */}
					<script is:inline set:html={TRACKER_PRELUDE} />
					{UMAMI_WEBSITE_ID && (
						<script
							is:inline
							defer
							src="https://cloud.umami.is/script.js"
							data-website-id={UMAMI_WEBSITE_ID}
							data-domains={SITE_HOST}
						/>
					)}
					{CLOUDFLARE_BEACON_TOKEN && (
						<script
							type="module"
							src="https://static.cloudflareinsights.com/beacon.min.js"
							data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_BEACON_TOKEN })}
						/>
					)}
				</>
			)
		}
	</body>
</html>
