---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_NAME } from '../../lib/events';
import { localePath } from '../../i18n/paths.mjs';

/* German only (the English pages link here, marked "(in German)"). */
const title = `Impressum – ${SITE_NAME}`;
const description = `Wer ${SITE_NAME} betreibt und wie man den Betreiber erreicht.`;
---

<Base title={title} description={description} locale="de" path="/impressum/">
	<SiteNav locale="de" path="/impressum/" />

	<main class="wrap legal">
		<h1>Impressum</h1>
		<p class="todo">Nur ein Gerüst. Der Betreiber muss vor dem Start jeden markierten Wert ergänzen; dies ist keine Rechtsberatung, der endgültige Text sollte geprüft werden.</p>

		<dl>
			<dt>Diensteanbieter (§ 5 DDG)</dt>
			<dd>[[TODO: owner to supply full name, or company name and legal form]]<br />[[TODO: owner to supply street and number, postcode, city, Germany]]</dd>

			<dt>Kontakt</dt>
			<dd>
				E-Mail: [[TODO: owner to supply contact email]]<br />
				[[TODO: owner to supply a second fast means of contact, e.g. phone or contact form]]<br />
				<a href={localePath('/contact/', 'de')}>Kontaktformular</a>
			</dd>

			<dt>Vertreten durch</dt>
			<dd>[[TODO: owner to supply, only if the provider is a company]]</dd>

			<dt>Registereintrag und USt-IdNr.</dt>
			<dd>[[TODO: owner to supply commercial register and number, and VAT id (USt-IdNr.), if any]]</dd>

			<dt>Verantwortlich für den Inhalt (§ 18 Abs. 2 MStV)</dt>
			<dd>[[TODO: owner to supply name and address, if this applies]]</dd>

			<dt>Worum es auf dieser Website geht</dt>
			<dd>
				Ein Verzeichnis von KI- und Daten-Events in Deutschland. Die Angaben zu den Events stammen von den
				öffentlichen Seiten der Veranstalter und werden täglich geprüft, können sich beim Veranstalter aber
				jederzeit ändern: Bitte vor Anreise oder Zahlung immer auf der Seite des Veranstalters bestätigen.
				{SITE_NAME} verkauft keine Tickets und erhält keine Provision.
			</dd>

			<dt>Haftung für externe Links</dt>
			<dd>
				[[TODO: owner to supply legal wording, reviewed]] Jeder Eintrag verweist auf eine Seite eines
				Dritten, für die deren Betreiber verantwortlich ist.
			</dd>

			<dt>Urheberrecht</dt>
			<dd>
				Namen und Beschreibungen der Events gehören ihren Veranstaltern. [[TODO: owner to supply wording on
				the selection and presentation of this site]]
			</dd>
		</dl>
	</main>

	<SiteFooter locale="de" />

	<style>
		.legal {
			padding: 24px 32px 64px;
			max-width: 640px;
		}
		h1 {
			font-size: clamp(1.6rem, 3vw, 2rem);
			margin: 16px 0 24px;
			letter-spacing: -0.01em;
		}
		dl {
			margin: 0;
			border-top: 1px solid var(--border);
		}
		dt {
			font-size: 0.8rem;
			font-weight: 600;
			color: var(--muted);
			padding: 18px 0 6px;
		}
		dd {
			margin: 0;
			padding: 0 0 18px;
			line-height: 1.6;
			border-bottom: 1px solid var(--border);
		}
		@media (max-width: 640px) {
			.legal {
				padding: 16px 18px 48px;
			}
		}
	</style>
</Base>
