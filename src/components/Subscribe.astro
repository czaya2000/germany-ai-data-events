---
import {
	SUBSCRIBE_ACTION,
	NEWSLETTER_CITIES,
	NEWSLETTER_FORMATS,
	cityTag,
	formatTag,
} from '../lib/newsletter.mjs';
import { t, displayCity, formatLabel, type Locale } from '../i18n';

interface Props {
	/** Page language. Sent to Buttondown as a `lang-de` / `lang-en` tag next to the city and format tags. */
	locale: Locale;
	/** Where the form was shown. Stored as Buttondown metadata so signups can be
	    attributed to a placement (home vs. event page). */
	placement: 'home' | 'event' | 'hub';
	compact?: boolean;
	/** Tags ticked from the start (a hub page ticks its own city or type). */
	preset?: string[];
	/** Replaces the default line under the form. */
	note?: string;
}

const { locale, placement, compact = false, preset = [], note } = Astro.props;
const s = t(locale);
const LANGS = [
	{ code: 'de', label: 'Deutsch' },
	{ code: 'en', label: 'English' },
];
const id = (s: string) => `sub-${placement}-${s}`;
// Homepage: form with this line at the bottom. Event pages (compact): line above.
const NOTE = note ?? s.subscribe.defaultNote;
---

<section class={`subscribe ${compact ? 'compact' : ''}`} id="subscribe">
	{compact && <p class="subscribe-title">{NOTE}</p>}
	<!-- Posts straight to Buttondown (no backend). Buttondown sends the double
	     opt-in email and creates any tag it doesn't know yet. Each ticked box
	     submits one `tag` value. Do not switch this to fetch(): Buttondown may
	     need the visitor to complete a CAPTCHA on its own page. -->
	<form action={SUBSCRIBE_ACTION} method="post" class="subscribe-form">
		<input type="hidden" name="embed" value="1" />
		<input type="hidden" name="metadata__placement" value={placement} />
		<div class="subscribe-row">
			<label for={id('email')}>
				<span class="sr-only">{s.subscribe.emailLabel}</span>
				<input
					type="email"
					name="email"
					id={id('email')}
					placeholder={s.subscribe.emailPlaceholder}
					required
					autocomplete="email"
				/>
			</label>
			<button
				class="btn accent sub-open"
				type="submit"
				data-umami-event="Digest: open"
				data-umami-event-placement={placement}>{s.subscribe.open}</button
			>
		</div>
		<!-- Opened by "Get weekly digest" once the email is valid (same pattern as the
		     calendar dialog). It sits inside the form, so the ticked boxes and the
		     final Subscribe button submit with it. Without JS the first button
		     simply submits: no tags, so the reader gets every city and type. -->
		<dialog class="sub-dialog" aria-labelledby={id('title')}>
			<div class="sub-head">
				<h2 id={id('title')}>{s.subscribe.dialogTitle}</h2>
				<button type="button" class="sub-close" aria-label={s.subscribe.close}>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<path fill="none" stroke="currentColor" stroke-width="2" d="M6 6l12 12M18 6 6 18"></path>
					</svg>
				</button>
			</div>
			<p class="sub-intro">{s.subscribe.intro}</p>
			<!-- Exactly one language tag is submitted: a radio group, defaulting to the page
			     language. The radios sit in the dialog, but a closed dialog still submits
			     its controls, so the no-JS path sends the default too. -->
			<fieldset class="sub-lang">
				<legend>{s.subscribe.language}</legend>
				<div class="choices">
					{LANGS.map((l) => (
						<label class="choice" for={id(`lang-${l.code}`)}>
							<input type="radio" name="tag" value={`lang-${l.code}`} id={id(`lang-${l.code}`)} checked={l.code === locale} />
							{l.label}
						</label>
					))}
				</div>
				<p class="sub-help">{s.subscribe.languageHelp}</p>
			</fieldset>
			<fieldset>
				<legend>{s.subscribe.cities}</legend>
				<div class="choices">
					{NEWSLETTER_CITIES.map((c) => (
						<label class="choice" for={id(cityTag(c.slug))}>
							<input type="checkbox" name="tag" value={cityTag(c.slug)} id={id(cityTag(c.slug))} checked={preset.includes(cityTag(c.slug))} />
							{displayCity(c.label, locale)}
						</label>
					))}
				</div>
			</fieldset>
			<fieldset>
				<legend>{s.subscribe.types}</legend>
				<div class="choices">
					{NEWSLETTER_FORMATS.map((f) => (
						<label class="choice" for={id(formatTag(f.label))}>
							<input type="checkbox" name="tag" value={formatTag(f.label)} id={id(formatTag(f.label))} checked={preset.includes(formatTag(f.label))} />
							{formatLabel(f.label, locale)}
						</label>
					))}
				</div>
			</fieldset>
			<button class="btn accent sub-submit" type="submit" data-umami-event="Digest signup" data-umami-event-placement={placement}>
				{s.subscribe.submit}
			</button>
			<p class="sub-note">{s.subscribe.confirmBefore}<strong class="sub-email"></strong>{s.subscribe.confirmAfter}</p>
		</dialog>
		{!compact && <p class="subscribe-note">{NOTE}</p>}
	</form>
</section>

<style>
	/* Homepage: no rule above; the form sits in a narrow column, left-aligned under the headline. */
	.subscribe {
		padding: 8px 0 28px;
		border-bottom: 1px solid var(--border);
	}
	.subscribe:not(.compact) .subscribe-form {
		max-width: 560px;
	}
	.subscribe-note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
	/* Event pages: line above the form, left-aligned. */
	.subscribe.compact {
		display: grid;
		gap: 14px;
		padding: 26px 0;
		border-top: 1px solid var(--border);
	}
	.subscribe-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
	}
	.subscribe-form {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
	}
	.subscribe-row {
		display: flex;
		gap: 10px;
		align-items: stretch;
	}
	.subscribe-row label {
		flex: 1;
		display: flex;
	}
	.subscribe-form input[type='email'] {
		flex: 1;
		min-width: 0;
		font: inherit;
		font-size: 0.95rem;
		padding: 10px 12px;
		border: 1px solid var(--border);
		border-radius: 0;
		background: var(--surface);
		color: var(--ink);
	}
	.subscribe-form input[type='email']:focus {
		outline: none;
		border-color: var(--ink);
	}
	.subscribe-row .btn {
		flex: none;
	}
	.choices {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.choice {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.85rem;
		padding: 5px 10px;
		background: var(--chip-bg);
		color: var(--chip-ink);
		cursor: pointer;
	}
	.choice:has(input:checked) {
		background: var(--ink);
		color: var(--bg);
	}
	.choice input {
		margin: 0;
		accent-color: var(--accent);
	}
	.choice:has(input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	@media (max-width: 420px) {
		.subscribe-row {
			flex-direction: column;
		}
	}
	.sub-dialog {
		width: min(480px, calc(100vw - 32px));
		max-height: calc(100dvh - 32px);
		padding: 24px;
		border: 1px solid var(--ink);
		border-radius: 0;
		background: var(--surface);
		color: var(--ink);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
	}
	.sub-dialog::backdrop {
		background: rgba(0, 0, 0, 0.35);
	}
	.sub-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}
	.sub-head h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.sub-close {
		display: inline-flex;
		width: 32px;
		height: 32px;
		margin: -6px -6px 0 0;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		color: var(--muted);
		cursor: pointer;
	}
	.sub-close:hover {
		color: var(--ink);
	}
	.sub-intro {
		margin: 6px 0 4px;
		font-size: 0.875rem;
		color: var(--ink-2);
	}
	.sub-dialog fieldset {
		border: 0;
		margin: 16px 0 0;
		padding: 0;
		min-width: 0;
	}
	.sub-dialog legend {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 6px;
		padding: 0;
	}
	.sub-help {
		margin: 6px 0 0;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.sub-submit {
		width: 100%;
		margin-top: 22px;
	}
	.sub-note {
		margin: 10px 0 0;
		font-size: 0.78rem;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.sub-note strong {
		color: var(--ink-2);
		font-weight: 600;
	}
	@media (max-width: 480px) {
		.sub-dialog {
			padding: 20px 16px;
		}
	}
</style>

<script>
	// One handler per subscribe block (the homepage and event pages each have one).
	document.querySelectorAll<HTMLFormElement>('.subscribe-form').forEach((form) => {
		const email = form.querySelector<HTMLInputElement>('input[type="email"]')!;
		const dialog = form.querySelector<HTMLDialogElement>('.sub-dialog')!;
		const opener = form.querySelector<HTMLButtonElement>('.sub-open')!;
		opener.addEventListener('click', (ev) => {
			ev.preventDefault();
			if (!email.reportValidity()) return;
			form.querySelector('.sub-email')!.textContent = email.value.trim();
			dialog.showModal();
		});
		form.querySelector('.sub-close')!.addEventListener('click', () => dialog.close());
		// A click on the backdrop lands on the <dialog> element itself.
		dialog.addEventListener('click', (ev) => {
			if (ev.target === dialog) dialog.close();
		});
		dialog.addEventListener('close', () => opener.focus());
	});
</script>
