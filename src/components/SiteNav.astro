---
import { SITE_NAME, LINKEDIN_URL } from '../lib/events';
import { localePath, switchLocalePath, LOCALE_PREFIX, HTML_LANG } from '../i18n/paths.mjs';
import { t, type Locale } from '../i18n';
import CalendarSubscribe from './CalendarSubscribe.astro';

interface Props {
	locale: Locale;
	/** Site path of the page in its own language, no base, no /en/ prefix ("/events/x/"). */
	path: string;
}
const { locale, path } = Astro.props;
const s = t(locale);
const sitePath = `${LOCALE_PREFIX[locale]}${path}`;
// Plain links to the same page in each language: no redirect, no detection, no cookie.
const langs = (['de', 'en'] as const).map((l) => ({ code: l, href: switchLocalePath(sitePath, l) }));
---

<header class="topbar">
	<div class="topbar-inner wrap">
		<a class="brand" href={localePath('/', locale)}>
			<svg class="mark" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
				<rect x="3" y="4" width="18" height="17" fill="none" stroke="currentColor" stroke-width="2"
				></rect>
				<rect x="3" y="4" width="18" height="4.5" class="mark-rule"></rect>
			</svg>
			<span>{SITE_NAME}</span>
		</a>
		<div class="topbar-controls">
			<slot />
			<nav class="lang-switch" aria-label={s.nav.langSwitch}>
				{
					langs.map((l, i) => (
						<>
							{i > 0 && <span aria-hidden="true">|</span>}
							<a
								href={l.href}
								lang={HTML_LANG[l.code]}
								hreflang={HTML_LANG[l.code]}
								aria-current={l.code === locale ? 'true' : undefined}
								title={s.nav.langName[l.code]}
								data-lang-switch
							>
								{l.code.toUpperCase()}
							</a>
						</>
					))
				}
			</nav>
			<button
				type="button"
				class="icon-btn"
				data-cal-open
				data-umami-event="Calendar: open"
				data-umami-event-from="header"
				aria-label={s.nav.calendarOpen}
				title={s.nav.calendarOpen}
			>
				<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<rect x="3" y="5" width="18" height="16"></rect>
					<path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5"></path>
				</svg>
			</button>
			{
				LINKEDIN_URL && (
					<a
						class="icon-btn"
						href={LINKEDIN_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={s.nav.linkedin}
						title={s.nav.linkedin}
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" />
						</svg>
					</a>
				)
			}
			<a class="icon-btn" href={localePath('/contact/', locale)} aria-label={s.nav.contact} title={s.nav.contact}>
				<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<rect x="3" y="5" width="18" height="14" rx="0"></rect>
					<path d="m3.5 6 8.5 7 8.5-7"></path>
				</svg>
			</a>
		</div>
	</div>
</header>
<div class="masthead-rule" aria-hidden="true"></div>
<CalendarSubscribe locale={locale} />

<script is:inline>
	// Keeps the filters (?city=…) and #hash when switching language. The links work without this.
	document.querySelectorAll('[data-lang-switch]').forEach(function (a) {
		a.addEventListener('click', function () {
			a.search = location.search;
			a.hash = location.hash;
		});
	});
</script>

<style>
	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0 6px;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.lang-switch a {
		color: var(--muted);
		text-decoration: none;
	}
	.lang-switch a:hover {
		color: var(--accent);
	}
	.lang-switch a[aria-current] {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 22px;
		padding-bottom: 18px;
		flex-wrap: wrap;
		gap: 10px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 11px;
		font-weight: 700;
		font-size: 1.18rem;
		letter-spacing: -0.015em;
		text-decoration: none;
		color: var(--ink);
	}
	/* The mark is the masthead device in miniature: the accent rule over a
	   field. The frame follows the ink so it inverts with the theme. */
	.mark {
		flex: none;
		display: block;
	}
	.mark-rule {
		fill: var(--accent);
	}
	.topbar-controls {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		color: var(--muted);
		text-decoration: none;
		background: none;
		border: none;
		cursor: pointer;
	}
	.icon-btn:hover {
		color: var(--accent);
	}
	/* The one bold moment on every page: a single accent rule under the
	   masthead. The only other place the accent appears is the current week. */
	.masthead-rule {
		height: 3px;
		background: var(--accent);
	}
	@media (max-width: 640px) {
		.topbar-inner {
			padding-top: 16px;
			padding-bottom: 14px;
		}
		.brand {
			font-size: 1.05rem;
			gap: 9px;
		}
	}
</style>
