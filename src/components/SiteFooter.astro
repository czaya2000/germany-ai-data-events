---
import { SITE_NAME } from '../lib/events';
import { localePath, legalPath } from '../i18n/paths.mjs';
import { t, type Locale } from '../i18n';

/* One footer for every page. The page-specific line (last-scanned, scope
   note) comes through the slot; the link row is the same everywhere so
   organisers and sponsors can always find their way in. Impressum and
   Datenschutz are always one click away, in the page's own language
   (/impressum/ and /datenschutz/, /en/legal-notice/ and /en/privacy/). */

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const privacyHref = localePath(legalPath('datenschutz', locale), locale);
const impressumHref = localePath(legalPath('impressum', locale), locale);

// Link row suppressed for now — flip back on when ready.
const SHOW_LINKS = false;
---

<footer class="site-footer wrap">
	<p><slot>{SITE_NAME}. <a href={localePath('/', locale)}>{s.footer.backToAll}</a>.</slot></p>
	<p class="footer-data">
		<a href={localePath('/data/', locale)}>{s.footer.dataFeeds}</a>{s.footer.dataFeedsSuffix}
		<span aria-hidden="true"> · </span><a href={privacyHref}>{s.footer.privacy}</a>
		<span aria-hidden="true"> · </span><a href={impressumHref}>{s.footer.impressum}</a>
	</p>
	{
		SHOW_LINKS && (
			<nav class="footer-links" aria-label={s.footer.linksAria}>
				<a href={localePath('/submit/', locale)}>{s.footer.submit}</a>
				<a href={localePath('/#subscribe', locale)}>{s.footer.weeklyDigest}</a>
				<a href={localePath('/contact/?topic=sponsor', locale)}>{s.footer.sponsor}</a>
				<a href={impressumHref}>{s.footer.impressum}</a>
				<a href={privacyHref}>{s.footer.privacy}</a>
			</nav>
		)
	}
</footer>

<style>
	.footer-data {
		margin-top: 8px;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.footer-data a {
		color: inherit;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 22px;
		margin-top: 18px;
	}
	.footer-links a {
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}
	.footer-links a:hover {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}
</style>
