---
import { withBase } from '../lib/events';
import { SITE_NAME } from '../lib/events';

/* One footer for every page. The page-specific line (last-scanned, scope
   note) comes through the slot; the link row is the same everywhere so
   organisers and sponsors can always find their way in. */

// Link row suppressed for now — flip back on when ready.
const SHOW_LINKS = false;
---

<footer class="site-footer wrap">
	<p><slot>{SITE_NAME}. <a href={withBase('/')}>Back to all events</a>.</slot></p>
	<p class="footer-data">
		<a href={withBase('/data/')}>Data &amp; feeds</a> for apps and AI agents
		<span aria-hidden="true"> · </span><a href={withBase('/privacy/')}>Privacy</a>
		<span aria-hidden="true"> · </span><a href={withBase('/impressum/')}>Impressum</a>
	</p>
	{
		SHOW_LINKS && (
			<nav class="footer-links" aria-label="Site">
				<a href={withBase('/submit/')}>Submit an event</a>
				<a href={withBase('/#subscribe')}>Weekly digest</a>
				<a href={withBase('/contact/?topic=sponsor')}>Reach German data leaders? Get in touch</a>
				<a href={withBase('/impressum/')}>Impressum</a>
				<a href={withBase('/privacy/')}>Privacy</a>
			</nav>
		)
	}
</footer>

<style>
	.footer-data {
		margin-top: 8px;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.footer-data a {
		color: inherit;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 22px;
		margin-top: 18px;
	}
	.footer-links a {
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}
	.footer-links a:hover {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}
</style>
