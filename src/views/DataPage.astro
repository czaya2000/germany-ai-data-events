---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME, getUpcomingEvents, withBase } from '../lib/events';
import { feedHttpsUrl, listFeeds } from '../lib/calendar-feeds';
import { ENDPOINTS, hubMarkdownPath } from '../lib/public-data';
import { HUBS, isHubLive } from '../lib/hubs.mjs';
import { t, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).data;

const upcoming = await getUpcomingEvents();
// The city and type lists that /llms.txt links (enough events to be worth it).
const mdLists = HUBS.filter((h) => isHubLive(h, upcoming.map((e) => e.data)));
// Single-dimension feeds only (all, each city, each format); the pairs are in the calendar modal.
const feeds = listFeeds(upcoming, locale).filter((f) => !(f.city && f.format));

const title = s.title(SITE_NAME);
const description = s.description(SITE_NAME);
const calPrefix = locale === 'en' ? '/en' : '';
---

<Base title={title} description={description} locale={locale} path="/data/">
	<SiteNav locale={locale} path="/data/" />

	<main class="wrap legal">
		<h1>{s.h1}</h1>
		<p class="intro">{s.intro(SITE_NAME)}</p>

		<h2>{s.endpoints}</h2>
		<ul>
			<li><a href={ENDPOINTS.json}><code>/events.json</code></a>{s.eventsJson}</li>
			<li><a href={ENDPOINTS.rss}><code>/rss.xml</code></a>{s.rss} <a href={ENDPOINTS.rssEn}><code>/en/rss.xml</code></a>{s.rssEn}</li>
			<li><a href={ENDPOINTS.llms}><code>/llms.txt</code></a>{s.llms}</li>
			<li><a href={ENDPOINTS.llmsFull}><code>/llms-full.txt</code></a>{s.llmsFull}</li>
			<li>
				{s.mdLists}<code>.md</code>:
				{mdLists.map((h, i) => (
					<>{i > 0 && ', '}<a href={withBase(hubMarkdownPath(h))}><code>{hubMarkdownPath(h)}</code></a></>
				))}.
			</li>
			<li><a href={ENDPOINTS.ics}><code>/calendar/all.ics</code></a>{s.ics}<a href={ENDPOINTS.icsEn}><code>/en/calendar/all.ics</code></a>.</li>
		</ul>

		<h2>{s.calendarFeeds}</h2>
		<p>{s.calendarIntro}</p>
		<ul class="feeds">
			{feeds.map((f) => (
				<li>
					<a href={feedHttpsUrl(f.slug, locale)}><code>{`${calPrefix}/calendar/${f.slug}.ics`}</code></a>
					<span>{f.slug === 'all' ? s.allEvents : f.name.replace(`${SITE_NAME} – `, '')} ({f.events.length})</span>
				</li>
			))}
		</ul>

		<h2>{s.fieldsIn}<code>/events.json</code></h2>
		<dl class="fields">
			{s.fields.map(([k, v]) => (
				<>
					<dt><code>{k}</code></dt>
					<dd>{v}</dd>
				</>
			))}
		</dl>

		<h2>{s.notes}</h2>
		<p>
			{s.note1}<code>version</code>{s.note1After}
		</p>
		<p>
			{s.note2a}<code>start</code>{s.note2b}<code>end</code>{s.note2c}<code>time</code>{s.note2d}
		</p>
		<p>
			<code>lastScan</code>{s.note3a}<code>/events.json</code>{s.note3b}
		</p>
		<p>{s.note4}</p>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.legal {
			padding: 24px 32px 64px;
			max-width: 720px;
		}
		h1 {
			font-size: clamp(1.6rem, 3vw, 2rem);
			margin: 16px 0 8px;
			letter-spacing: -0.01em;
		}
		h2 {
			font-size: 0.95rem;
			font-weight: 600;
			margin: 28px 0 6px;
		}
		p,
		li,
		dd {
			line-height: 1.65;
			color: var(--ink-2);
		}
		p {
			margin: 0;
		}
		p + p {
			margin-top: 10px;
		}
		.intro {
			color: var(--muted);
		}
		ul {
			margin: 6px 0 0;
			padding-left: 18px;
		}
		.feeds {
			list-style: none;
			padding: 0;
		}
		.feeds li {
			display: flex;
			flex-wrap: wrap;
			gap: 4px 12px;
		}
		.feeds span {
			color: var(--muted);
		}
		.fields {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 6px 20px;
			margin: 8px 0 0;
		}
		.fields dd {
			margin: 0;
		}
		code {
			font-size: 0.85em;
			background: var(--chip-bg);
			padding: 1px 5px;
		}
		@media (max-width: 640px) {
			.legal {
				padding: 16px 18px 48px;
			}
			.fields {
				grid-template-columns: 1fr;
				gap: 0;
			}
			.fields dd {
				margin-bottom: 10px;
			}
		}
	</style>
</Base>
