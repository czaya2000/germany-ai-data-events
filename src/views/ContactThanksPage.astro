---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../lib/events';
import { t, type Locale } from '../i18n';
import { localePath } from '../i18n/paths.mjs';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const title = s.contact.thanksTitle(SITE_NAME);
const description = s.contact.thanksDescription;
---

<Base title={title} description={description} locale={locale} path="/contact/thanks/" noindex>
	<SiteNav locale={locale} path="/contact/thanks/" />

	<main class="wrap thanks">
		<h1>{s.contact.thanksH1}</h1>
		<p>{s.contact.thanksText}</p>
		<a class="btn accent" href={localePath('/', locale)}>{s.thanks.backToAll}</a>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.thanks {
			padding: 60px 24px;
			text-align: center;
		}
		h1 {
			font-size: clamp(1.5rem, 3vw, 2rem);
			margin: 0 0 8px;
		}
		p {
			color: var(--muted);
			margin: 0 0 28px;
		}
	</style>
</Base>
