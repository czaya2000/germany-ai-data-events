---
/* Buttondown sends people here after they click the confirmation link
   (newsletter setting `subscription_confirmation_redirect_url`, set with
   scripts/buttondown-redirects.mjs). Keep the path stable. Buttondown has one
   redirect address, so it points at the German page; the English page is
   /en/subscribe/confirmed/. */
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../lib/events';
import { t, type Locale } from '../i18n';
import { localePath } from '../i18n/paths.mjs';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).thanks;
const title = s.confirmedTitle(SITE_NAME);
const description = s.confirmedDescription;
---

<Base title={title} description={description} locale={locale} path="/subscribe/confirmed/" noindex>
	<SiteNav locale={locale} path="/subscribe/confirmed/" />

	<main class="wrap confirmed">
		<h1>{s.confirmedH1}</h1>
		<p>{s.confirmedText}</p>
		<a class="btn accent" href={localePath('/', locale)}>{s.seeAll}</a>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.confirmed {
			padding: 60px 32px;
			text-align: center;
		}
		h1 {
			font-size: clamp(1.5rem, 3vw, 2rem);
			margin: 0 0 8px;
		}
		p {
			color: var(--muted);
			margin: 0 auto 28px;
			max-width: 48ch;
		}
	</style>
</Base>
