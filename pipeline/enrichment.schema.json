{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "enrichment.schema.json",
	"description": "Shape of work/enrichment.json written by the Claude step. Enforced by pipeline/lib/verify.mjs (a small validator for this keyword subset). Items are validated one by one: an invalid item is dropped and counted, the rest of the file is still used.",
	"type": "object",
	"required": ["results"],
	"properties": {
		"results": { "type": "array", "items": { "$ref": "#/definitions/result" } },
		"extracted": {
			"type": "object",
			"additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/extractedEvent" } }
		}
	},
	"definitions": {
		"format": { "enum": ["Meetup", "Conference", "Workshop", "Networking", "Webinar"] },
		"cost": { "type": "string", "pattern": "^(Free|Not listed|(From )?EUR [0-9]{1,5}([.,][0-9]{1,2})?)$" },
		"topics": {
			"type": "array",
			"minItems": 1,
			"maxItems": 4,
			"items": { "type": "string", "minLength": 1, "maxLength": 40 }
		},
		"blurb": { "type": "string", "minLength": 1, "maxLength": 220 },
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "relevant"],
			"properties": {
				"id": { "type": "string", "pattern": "^c_[0-9a-f]{10}$" },
				"relevant": { "type": "boolean" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"reason": { "type": "string", "pattern": "^[a-z-]{1,24}$" },
				"format": { "$ref": "#/definitions/format" },
				"city": { "type": ["string", "null"], "maxLength": 40 },
				"topics": { "$ref": "#/definitions/topics" },
				"blurb": { "$ref": "#/definitions/blurb" },
				"cost": { "$ref": "#/definitions/cost" }
			}
		},
		"extractedEvent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["title", "date", "city", "organiser", "url", "format", "topics", "blurb"],
			"properties": {
				"title": { "type": "string", "minLength": 3, "maxLength": 200 },
				"date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
				"endDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
				"time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9](–[0-2][0-9]:[0-5][0-9])?$" },
				"city": { "type": ["string", "null"], "maxLength": 40 },
				"venue": { "type": "string", "maxLength": 160 },
				"organiser": { "type": "string", "minLength": 1, "maxLength": 120 },
				"url": { "type": "string", "maxLength": 500 },
				"cost": { "$ref": "#/definitions/cost" },
				"format": { "$ref": "#/definitions/format" },
				"topics": { "$ref": "#/definitions/topics" },
				"blurb": { "$ref": "#/definitions/blurb" }
			}
		}
	}
}
